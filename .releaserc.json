{
	"branches": [
		"main"
	],
	"plugins": [
		"@semantic-release/commit-analyzer",
		"@semantic-release/release-notes-generator",
		[
			"@semantic-release/exec",
			{
				"prepareCmd": "node scripts/prepare-platform-packages.ts ${nextRelease.version}",
				"publishCmd": "node scripts/publish-platform-packages.ts"
			}
		],
		"@semantic-release/npm",
		[
			"@semantic-release/github",
			{
				"assets": [
					"build/release/*"
				]
			}
		]
	]
}
